{
    "services": {
        "frontend": {
            "root": ".",
            "framework": "nextjs"
        },
        "scraping-service": {
            "root": "services/scraping-service"
        }
    },
    "rewrites": [
        {
            "source": "/api/scraping-service(/.*)?",
            "destination": {
                "type": "service",
                "service": "scraping-service"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}