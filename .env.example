# MongoDB
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/prep-ai"
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/prep-ai"

# NextAuth
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# OAuth providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# AI provider
GROQ_API_KEY="your-groq-api-key"

# Optional external Python scraping service
PYTHON_SERVICE_URL="https://your-python-service.example.com"
SCRAPING_SERVICE_URL="https://your-python-service.example.com"

# Optional mail configuration
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="user@example.com"
EMAIL_SERVER_PASSWORD="app-password"
EMAIL_FROM="PrepAI <noreply@example.com>"
