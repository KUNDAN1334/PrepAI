# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Only MONGODB_URI, AUTH_SECRET and GROQ_API_KEY
# are required to run the app; everything else is optional.
# ---------------------------------------------------------------------------

# MongoDB (Atlas or local). DATABASE_URL is accepted as an alias.
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/prep-ai"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# OAuth (optional). Leave blank and the provider is not registered at all,
# so the sign-in page still works with email + password only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# Groq — required for resume analysis, mock interviews and auto-tagging.
GROQ_API_KEY="your-groq-api-key"
# Optional: override the model used for every AI call.
GROQ_MODEL="llama-3.1-8b-instant"

# Optional Python research service (services/scraping-service).
# Without it, company research degrades to curated source links.
PYTHON_SERVICE_URL="http://localhost:8000"
