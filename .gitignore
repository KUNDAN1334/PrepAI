# .gitignore

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
.next

# Production
/build
dist/

# Misc
.DS_Store
*.pem
.vscode/
.idea/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Environment Variables (CRITICAL - Never commit these!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
**/.env
**/.env.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Python (for scraping service)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
services/scraping-service/venv/
services/scraping-service/__pycache__/
*.pyc

# Database
*.db
*.sqlite
*.sqlite3

# OS
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log

# Temporary files
tmp/
temp/

# Unrelated / nested projects that must never be part of this Next.js build.
# PrepAI was previously committed as a broken submodule gitlink (no .gitmodules),
# which made Vercel's clone step fail.
/PrepAI/
/Threaded_v0/
/Authentication_API/
